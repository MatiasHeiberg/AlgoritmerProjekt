    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Algoritmer_Projekt</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="notSorted.json" />
    <None Remove="reverseSorted.json" />
    <None Remove="sorted.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="notSorted.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
